{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/server/index.ts",
    "electron-main.js",
    "index.html",
    "vite.config.ts",
    "scripts/**/*.{ts,mjs}",
    "src/features/file-hub/FileHubPage.tsx",
    "src/features/ssh-hub/SshHubPage.tsx",
    "src/features/rdp-hub/RdpHubPage.tsx",
    "src/features/cms-site/CmsSiteHomePage.tsx",
    "src/features/cms-site/CmsSiteArticlePage.tsx",
    "src/features/cms-site/components/CmsSiteBrandSlot.tsx",
    "src/features/cms-site/components/CmsSiteCtaSlot.tsx",
    "src/features/cms-site/components/CmsSiteFooterSlot.tsx",
    "src/features/cms-site/components/CmsSiteNavSlot.tsx",
    "src/features/vx-etl-console/VxEtlConsolePage.tsx",
    "src/features/vx-business-rules-reference/VxBusinessRulesReferencePage.tsx",
    "src/features/vx-org-membership-transfer/VxOrgMembershipTransferPage.tsx",
    "src/features/vx-geo-responsibility/VxGeoResponsibilityPage.tsx",
    "src/features/vx-courses-activities/VxCoursesActivitiesPage.tsx",
    "src/features/vx-targhin-admin/VxMemberTarghinAdminPage.tsx",
    "src/features/vx-phone-requests-admin/VxMemberPhoneRequestsAdminPage.tsx",
    "src/features/vx-members-targhin/VxMemberTarghinMembersListPage.tsx",
    "src/features/vx-member-dossier/VxMemberDossierPage.tsx",
    "src/features/vx-member-dossier/VxMemberDossierViewPage.tsx",
    "src/features/vx-member-dossier/VxMemberDossierEditPage.tsx",
    "src/domain/vx/vxActivitySelfAnnouncement.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "vite.config.ts"
  ],
  "ignore": [
    "src/generated/**",
    "runtime/**",
    "scripts/archive/**",
    "src/domain/component-designer/DesignerBaseInfoRecordFormField.tsx",
    "src/domain/component-designer/DesignerCmsContentAssetsField.tsx",
    "src/domain/component-designer/DesignerRelatedContentsListField.tsx",
    "src/domain/component-designer/DesignerRelationTagsListField.tsx",
    "src/shared/lib/appendoo/v5Baseline/**",
    "scripts/vite/remote-hub-client-lib-stubs/**"
  ],
  "ignoreDependencies": [
    "@fontsource/ibm-plex-mono",
    "@fontsource/ibm-plex-sans",
    "@fontsource/ibm-plex-sans-arabic",
    "@fontsource/inter",
    "@fontsource/noto-sans-arabic",
    "@fontsource/parastoo",
    "@fontsource/rubik",
    "@fontsource/source-sans-3",
    "@fontsource/vazirmatn",
    "mongodb",
    "mysql2",
    "oracledb",
    "swagger-ui-dist",
    "react-doodle-icons",
    "@tabler/icons-react",
    "@phosphor-icons/react",
    "@heroicons/react",
    "@solar-icons/react",
    "@iconify-json/marketeq",
    "@iconify/react",
    "@iconify-json/simple-icons",
    "animate.css",
    "@huggingface/transformers",
    "sqlite3",
    "tedious",
    "vite",
    "@xterm/xterm",
    "@xterm/addon-fit",
    "basic-ftp",
    "guacamole-common-js"
  ],
  "rules": {
    "files": "error",
    "exports": "warn",
    "types": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "duplicates": "warn"
  }
}
