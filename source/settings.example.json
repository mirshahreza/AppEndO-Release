        "enabled": false,
        "serviceRoleName": "DEVELOPER"
      }
    },
    "mcpServers": [],
    "webSearch": {
      "provider": "disabled",
      "maxResults": 5
    },
    "http": {
      "allowedHostnames": []
    }
  },
  "scheduler": {
    "enabled": true,
    "tickIntervalSec": 60,
    "defaultTimezone": "UTC",
    "missedRunPolicy": "skip",
    "tasks": []
