  manuallyAssignedByUserId BigInt?   @map("manually_assigned_by_user_id")
  claimedAt                DateTime? @map("claimed_at")
  claimedByUserId          BigInt?   @map("claimed_by_user_id")
  portalSlug               String?   @map("portal_slug")
  pageKey                  String?   @map("page_key")
  route                    String?
  metadataJson             String?   @map("metadata_json") @db.Text
  messageCount             Int       @default(0) @map("message_count")
  lastMessageAt            DateTime? @map("last_message_at")
  duplicateOfId            BigInt?   @map("duplicate_of_id")
  resolvedAt               DateTime? @map("resolved_at")
  resolvedByUserId         BigInt?   @map("resolved_by_user_id")
  createdAt                DateTime? @default(now()) @map("created_at")
  updatedAt                DateTime? @default(now()) @map("updated_at")

  submitterUser          BaseUser? @relation("FeedbackSubmitter", fields: [submitterUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assigneeUser           BaseUser? @relation("FeedbackAssignee", fields: [assigneeUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  claimedByUser          BaseUser? @relation("FeedbackClaimedBy", fields: [claimedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolvedByUser         BaseUser? @relation("FeedbackResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manuallyAssignedByUser BaseUser? @relation("FeedbackManualAssign", fields: [manuallyAssignedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicateOf            BaseAppFeedback?  @relation("FeedbackDuplicate", fields: [duplicateOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates             BaseAppFeedback[] @relation("FeedbackDuplicate")
  messages               BaseAppFeedbackMessage[]
  attachments            BaseAppFeedbackAttachment[]
  readCursors            BaseAppFeedbackReadCursor[]

  @@index([status, submittedAt(sort: Desc)], map: "idx_app_feedback_status_submitted")
  @@index([submitterUserId], map: "idx_app_feedback_submitter")
  @@index([assigneeUserId], map: "idx_app_feedback_assignee_user")
  @@index([assigneeRoleName], map: "idx_app_feedback_assignee_role")
  @@index([type], map: "idx_app_feedback_subject")
  @@index([lastMessageAt(sort: Desc)], map: "idx_app_feedback_last_message")
  @@map("base_app_feedback")
}

