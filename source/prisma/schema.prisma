  terminalAt         DateTime? @map("terminal_at")

  instance      WorkflowInstance       @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodeInstances WorkflowNodeInstance[]
  joinArrivals  WorkflowJoinArrival[]

  @@unique([workflowInstanceId, splitNodeKey, branchEdgeKey], map: "uq_base_workflow_branch_tokens_split_edge")
  @@map("base_workflow_branch_tokens")
}

model WorkflowJoinArrival {
