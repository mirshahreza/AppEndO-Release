// Control plane schema — cross-provider naming via @@map / @map (p-45 PRM-1).
// schema.prisma stays on postgresql for client generate. Recommended runtime provider is SQL Server.
// Switch `provider` + DATABASE_URL for PostgreSQL / MySQL / SQLite smoke.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BaseUser {
  id                BigInt    @id @default(autoincrement())
  username          String    @unique
  email             String?   @unique
  passwordHash      String    @map("password_hash")
  isBuiltin         Boolean   @default(false) @map("is_builtin")
  locked            Int       @default(0)
  lockedAt          DateTime? @map("locked_at")
  lockedBy          BigInt?   @map("locked_by")
  unlockedAt        DateTime? @map("unlocked_at")
  unlockedBy        BigInt?   @map("unlocked_by")
  loginFailCount    Int       @default(0) @map("login_fail_count")
  loginFailLastAt   DateTime? @map("login_fail_last_at")
  lastLoginAt       DateTime? @map("last_login_at")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  mobile            String?
  mobileVerifiedAt  DateTime? @map("mobile_verified_at")
  createdAt         DateTime? @default(now()) @map("created_at")
  createdBy         BigInt?   @map("created_by")
  updatedAt         DateTime? @default(now()) @map("updated_at")
  updatedBy         BigInt?   @map("updated_by")

  otpChallenges       BaseOtpChallenge[]
  profile             BaseUserProfile?
  identities          BaseUserIdentity[]
  userRoles           BaseUserRole[]
  refreshTokens       BaseAuthRefreshToken[]
  attributeValues     BaseUserAttribute[]
  authAuditLogs       BaseAuthAuditLog[]
  chatSessions        BaseAiChatSession[]
  agentTraces         BaseAiAgentTrace[]
  agentApplySnapshots BaseAiAgentApplySnapshot[]
  contactMessages     BaseContactMessage[]
  feedbackTicketsSubmitted BaseAppFeedback[] @relation("FeedbackSubmitter")
  feedbackTicketsAssigned  BaseAppFeedback[] @relation("FeedbackAssignee")
  feedbackTicketsClaimed   BaseAppFeedback[] @relation("FeedbackClaimedBy")
  feedbackTicketsResolved  BaseAppFeedback[] @relation("FeedbackResolvedBy")
  feedbackTicketsManualAssign BaseAppFeedback[] @relation("FeedbackManualAssign")
  feedbackMessages         BaseAppFeedbackMessage[]
  feedbackAttachments      BaseAppFeedbackAttachment[]
  feedbackReadCursors      BaseAppFeedbackReadCursor[]
  scopeMemberships         BaseScopeMembership[]
  scopeMembershipEventsAsSubject BaseScopeMembershipEvent[] @relation("ScopeMembershipEventSubject")
  scopeMembershipEventsAsActor   BaseScopeMembershipEvent[] @relation("ScopeMembershipEventActor")
  scopeRoleMembershipEventsAsActor BaseScopeRoleMembershipEvent[] @relation("ScopeRoleMembershipEventActor")
  notifications                    BaseUserNotification[]
  notificationPreferences         UserNotificationPreference[]
  notificationDigestItems         UserNotificationDigestItem[]

  @@index([createdAt], map: "idx_base_users_created_at")
  @@index([updatedAt], map: "idx_base_users_updated_at")
  @@index([locked], map: "idx_base_users_locked")
  @@map("base_users")
}

model BaseOtpChallenge {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt?   @map("user_id")
  purpose   String
  channel   String
  target    String
  otpHash   String    @map("otp_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime? @default(now()) @map("created_at")
  createdBy BigInt?   @map("created_by")

  user BaseUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_otp_challenges_user_id")
  @@index([expiresAt], map: "idx_otp_challenges_expires_at")
  @@map("base_otp_challenges")
}

model BaseInfo {
  id        String   @id
  parentId  String?  @map("parent_id")
  title     String?
  shortName String?  @map("short_name")
  viewOrder Decimal? @map("view_order")
  note      String?  @db.Text
  metadata  String?  @db.Text
  value     Int?
  isActive  Boolean  @default(true) @map("is_active")
  uiColor   String?  @map("ui_color")
  uiHtml    String?  @map("ui_html") @db.Text
  createdAt DateTime? @default(now()) @map("created_at")
  createdBy BigInt?  @map("created_by")
  updatedAt DateTime? @default(now()) @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  parent   BaseInfo?  @relation("BaseInfoTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children BaseInfo[] @relation("BaseInfoTree")

  profileGenderRefs     BaseUserProfile[]        @relation("ProfileGender")
  profilePersonTypeRefs BaseUserProfile[]        @relation("ProfilePersonType")
  settingsAttributes    BaseSettingsAttribute[]
  contactMessages       BaseContactMessage[]

  @@index([parentId], map: "idx_base_info_parent_id")
  @@index([isActive], map: "idx_base_info_is_active")
  @@index([parentId, viewOrder, id], map: "idx_base_info_parent_order")
  @@map("base_info")
}

/// User ↔ Base Info node membership for org/geo (and future RPE dimensions).
/// nodeId is a Base Info id string without FK — hierarchical renames remap in app code.
model BaseScopeMembership {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  dimensionKey String    @map("dimension_key")
  nodeId       String    @map("node_id")
  createdAt    DateTime? @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  user BaseUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, dimensionKey, nodeId], map: "uq_scope_memberships_user_dim_node")
  @@index([nodeId, dimensionKey], map: "idx_scope_memberships_node_dim")
  @@index([userId, dimensionKey], map: "idx_scope_memberships_user_dim")
  @@map("base_scope_memberships")
}

/// Append-only audit of scope membership assign / remove.
model BaseScopeMembershipEvent {
  id             BigInt    @id @default(autoincrement())
  dimensionKey   String    @map("dimension_key")
  nodeId         String    @map("node_id")
  userId         BigInt    @map("user_id")
  eventType      String    @map("event_type")
  actorUserId    BigInt?   @map("actor_user_id")
  createdAt      DateTime? @default(now()) @map("created_at")

  user  BaseUser  @relation("ScopeMembershipEventSubject", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor BaseUser? @relation("ScopeMembershipEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([dimensionKey, nodeId, createdAt], map: "idx_scope_membership_events_node")
  @@index([userId, createdAt], map: "idx_scope_membership_events_user")
  @@index([createdAt], map: "idx_scope_membership_events_created")
  @@map("base_scope_membership_events")
}

/// Role ↔ Base Info node membership (default scope granted by role). Binary only.
model BaseScopeRoleMembership {
  id           BigInt    @id @default(autoincrement())
  roleName     String    @map("role_name")
  dimensionKey String    @map("dimension_key")
  nodeId       String    @map("node_id")
  createdAt    DateTime? @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  role BaseRole @relation(fields: [roleName], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleName, dimensionKey, nodeId], map: "uq_scope_role_memberships_role_dim_node")
  @@index([nodeId, dimensionKey], map: "idx_scope_role_memberships_node_dim")
  @@index([roleName, dimensionKey], map: "idx_scope_role_memberships_role_dim")
  @@map("base_scope_role_memberships")
}

/// Append-only audit of role scope membership assign / remove.
model BaseScopeRoleMembershipEvent {
  id           BigInt    @id @default(autoincrement())
  dimensionKey String    @map("dimension_key")
  nodeId       String    @map("node_id")
  roleName     String    @map("role_name")
  eventType    String    @map("event_type")
  actorUserId  BigInt?   @map("actor_user_id")
  createdAt    DateTime? @default(now()) @map("created_at")

  actor BaseUser? @relation("ScopeRoleMembershipEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([dimensionKey, nodeId, createdAt], map: "idx_scope_role_membership_events_node")
  @@index([roleName, createdAt], map: "idx_scope_role_membership_events_role")
  @@index([createdAt], map: "idx_scope_role_membership_events_created")
  @@map("base_scope_role_membership_events")
}

model BaseUserProfile {
  userId              BigInt  @id @map("user_id")
  firstname           String?
  lastname            String?
  fathername          String?
  grandfathername     String?
  phone               String?
  nickname            String?
  nationalCode        String? @map("national_code")
  birthYear           String? @map("birth_year")
  birthMonth          String? @map("birth_month")
  birthDay            String? @map("birth_day")
  genderCode          String? @map("gender_code")
  personTypeCode      String? @map("person_type_code")
  companyName         String? @map("company_name")
  registrationNumber  String? @map("registration_number")
  website             String? @map("website")
  profileImageBody    Bytes?  @map("profile_image_body")
  profileImageBodyXs  Bytes?  @map("profile_image_body_xs")
  profileImageMime    String? @map("profile_image_mime")
  profileImageSize    Int?    @map("profile_image_size")
  createdAt           DateTime? @default(now()) @map("created_at")
  createdBy           BigInt? @map("created_by")
  updatedAt           DateTime? @default(now()) @map("updated_at")
  updatedBy           BigInt? @map("updated_by")

  user       BaseUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender     BaseInfo? @relation("ProfileGender", fields: [genderCode], references: [id], onDelete: NoAction, onUpdate: NoAction)
  personType BaseInfo? @relation("ProfilePersonType", fields: [personTypeCode], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([firstname], map: "idx_base_user_profiles_firstname")
  @@index([lastname], map: "idx_base_user_profiles_lastname")
  @@map("base_user_profiles")
}

model BaseUserIdentity {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  providerId    String    @map("provider_id")
  providerKind  String    @map("provider_kind")
  subject       String
  email         String?
  emailVerified Boolean   @default(false) @map("email_verified")
  profileJson   String?   @map("profile_json") @db.Text
  linkedAt      DateTime? @default(now()) @map("linked_at")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime? @default(now()) @map("created_at")
  createdBy     BigInt?   @map("created_by")
  updatedAt     DateTime? @default(now()) @map("updated_at")
  updatedBy     BigInt?   @map("updated_by")

  user BaseUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, subject])
  @@index([userId], map: "idx_base_user_identities_user_id")
  @@map("base_user_identities")
}

model BaseRole {
  id        BigInt    @id @default(autoincrement())
  name      String    @unique
  note      String?   @db.Text
  createdAt DateTime? @default(now()) @map("created_at")
  createdBy BigInt?   @map("created_by")
  updatedAt DateTime? @default(now()) @map("updated_at")
  updatedBy BigInt?   @map("updated_by")

  userRoles           BaseUserRole[]
  mcpGrants           BaseRoleMcpGrant[]
  attributeValues     BaseRoleAttribute[]
  scopeRoleMemberships BaseScopeRoleMembership[]

  @@map("base_roles")
}

model BaseUserRole {
  userId    BigInt    @map("user_id")
  roleName  String    @map("role_name")
  createdBy BigInt?   @map("created_by")
  updatedAt DateTime? @default(now()) @map("updated_at")
  createdAt DateTime? @default(now()) @map("created_at")

  user BaseUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role BaseRole @relation(fields: [roleName], references: [name], onDelete: Cascade)

  @@id([userId, roleName])
  @@map("base_user_roles")
}

model BaseRoleMcpGrant {
  id           BigInt    @id @default(autoincrement())
  roleName     String    @map("role_name")
  resourceKind String    @map("resource_kind")
  resourceId   String    @map("resource_id")
  createdAt    DateTime? @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  role BaseRole @relation(fields: [roleName], references: [name], onDelete: Cascade)

  @@unique([roleName, resourceKind, resourceId])
  @@index([roleName], map: "idx_role_mcp_grants_role")
  @@map("base_role_mcp_grants")
}

model BaseSettingsAttribute {
  id              BigInt    @id @default(autoincrement())
  key             String
  label           String?
  scope           String
  sourceType      String    @map("source_type")
  baseInfoRootId  String?   @map("base_info_root_id")
  profileField    String?   @map("profile_field")
  dataType        String?   @map("data_type")
  cardinality     String    @default("single")
  minSelections   Int?      @map("min_selections")
  maxSelections   Int?      @map("max_selections")
  visibility      String    @default("BOTH")
  isRequired      Boolean   @default(false) @map("is_required")
  isActive        Boolean   @default(true) @map("is_active")
  viewOrder       Decimal   @default(0) @map("view_order")
  userEditable    Boolean   @default(false) @map("user_editable")
  userEditPolicy  String    @default("WHEN_EMPTY") @map("user_edit_policy")
  isBuiltin       Boolean   @default(false) @map("is_builtin")
  createdAt       DateTime? @default(now()) @map("created_at")
  createdBy       BigInt?   @map("created_by")
  updatedAt       DateTime? @default(now()) @map("updated_at")
  updatedBy       BigInt?   @map("updated_by")

  baseInfoRoot BaseInfo? @relation(fields: [baseInfoRootId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userValues   BaseUserAttribute[]
  roleValues   BaseRoleAttribute[]

  @@unique([scope, key], map: "uq_settings_attributes_scope_key")
  @@index([scope, isActive, viewOrder, id], map: "idx_settings_attributes_scope_active")
  @@map("base_settings_attributes")
}

model BaseSettingsProfileField {
  profileField   String    @id @map("profile_field")
  contextKey     String    @map("context_key")
  labelEn        String?   @map("label_en")
  isActive       Boolean   @default(false) @map("is_active")
  userEditPolicy String    @default("WHEN_EMPTY") @map("user_edit_policy")
  visibility     String    @default("BOTH")
  viewOrder      Decimal   @default(0) @map("view_order")
  createdAt      DateTime? @default(now()) @map("created_at")
  createdBy      BigInt?   @map("created_by")
  updatedAt      DateTime? @default(now()) @map("updated_at")
  updatedBy      BigInt?   @map("updated_by")

  @@index([isActive, viewOrder, profileField], map: "idx_settings_profile_fields_active")
  @@map("base_settings_profile_fields")
}

model BaseUserAttribute {
  id           BigInt    @id @default(autoincrement())
  definitionId BigInt    @map("definition_id")
  userId       BigInt    @map("user_id")
  valueText    String?   @map("value_text") @db.Text
  createdAt    DateTime? @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  definition BaseSettingsAttribute @relation(fields: [definitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       BaseUser              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([definitionId, userId], map: "uq_user_attributes_definition_user")
  @@index([userId, definitionId], map: "idx_user_attributes_user")
  @@map("base_users_attributes")
}

model BaseSettingsSection {
  sectionKey String    @id @map("section_key")
  value      String    @default("{}") @db.Text
  createdAt  DateTime? @default(now()) @map("created_at")
  createdBy  BigInt?   @map("created_by")
  updatedAt  DateTime? @default(now()) @map("updated_at")
  updatedBy  BigInt?   @map("updated_by")

  @@map("base_settings_sections")
}

model BaseRoleAttribute {
  id           BigInt    @id @default(autoincrement())
  definitionId BigInt    @map("definition_id")
  roleName     String    @map("role_name")
  valueText    String?   @map("value_text") @db.Text
  createdAt    DateTime? @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  definition BaseSettingsAttribute @relation(fields: [definitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role       BaseRole              @relation(fields: [roleName], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@unique([definitionId, roleName], map: "uq_role_attributes_definition_role")
  @@index([roleName, definitionId], map: "idx_role_attributes_role")
  @@map("base_roles_attributes")
}

model BaseAuthRefreshToken {
  id            BigInt    @id @default(autoincrement())
  tokenJti      String    @unique @map("token_jti")
  userId        BigInt    @map("user_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     BigInt    @map("expires_at")
  createdAt     DateTime? @default(now()) @map("created_at")
  createdBy     BigInt?   @map("created_by")
  revokedAt     DateTime? @map("revoked_at")
  updatedAt     DateTime? @default(now()) @map("updated_at")
  updatedBy     BigInt?   @map("updated_by")
  replacedByJti String?   @map("replaced_by_jti")
  userAgent     String?   @map("user_agent") @db.Text
  ipAddress     String?   @map("ip_address")

  user BaseUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_base_auth_refresh_tokens_user_id")
  @@map("base_auth_refresh_tokens")
}

model BaseAuthAuditLog {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt?   @map("user_id")
  email        String?
  eventType    String    @map("event_type")
  success      Int       @default(0)
  reason       String?  @db.Text
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  metadataJson String?   @map("metadata_json") @db.Text
  createdAt    DateTime? @default(now()) @map("created_at")
  createdBy    BigInt?   @map("created_by")
  updatedAt    DateTime? @default(now()) @map("updated_at")
  updatedBy    BigInt?   @map("updated_by")

  user BaseUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt], map: "idx_base_logs_auth_audit_created_at")
  @@index([userId, createdAt], map: "idx_base_logs_auth_audit_user_created")
  @@index([eventType, createdAt], map: "idx_base_logs_auth_audit_event_created")
  @@map("base_logs_auth_audit")
}

model BaseAppLog {
  id            BigInt    @id @default(autoincrement())
  actor         String    @default("SYSTEM")
  callSuccess   Int?      @map("call_success")
  failureReason String?   @map("failure_reason") @db.Text
  durationMs    Int?      @map("duration_ms")
  level         String
  context       String
  message       String    @db.Text
  messageSize   Int       @default(0) @map("message_size")
  hasMeta       Int       @default(0) @map("has_meta")
  metaJson      String?   @map("meta_json") @db.Text
  metaSize      Int       @default(0) @map("meta_size")
  createdAt     DateTime? @default(now()) @map("created_at")
  createdBy     BigInt?   @map("created_by")
  updatedAt     DateTime? @default(now()) @map("updated_at")
  updatedBy     BigInt?   @map("updated_by")

  @@index([createdAt(sort: Desc)], map: "idx_app_logs_created_at")
  @@index([level], map: "idx_app_logs_level")
  @@index([context], map: "idx_app_logs_context")
  @@index([actor], map: "idx_app_logs_actor")
  @@map("base_logs_app")
}

model BaseJob {
  id               BigInt    @id @default(autoincrement())
  jobType          String    @map("job_type")
  status           String    @default("pending")
  progress         Int       @default(0)
  progressMessage  String?   @map("progress_message") @db.Text
  payloadJson      String?   @map("payload_json") @db.Text
  resultJson       String?   @map("result_json") @db.Text
  errorMessage     String?   @map("error_message") @db.Text
  cancelRequested  Int       @default(0) @map("cancel_requested")
  attemptCount     Int       @default(0) @map("attempt_count")
  maxAttempts      Int       @default(3) @map("max_attempts")
  queuedAt         DateTime? @default(now()) @map("queued_at")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime? @default(now()) @map("created_at")
  createdBy        BigInt?   @map("created_by")
  updatedAt        DateTime? @default(now()) @map("updated_at")
  updatedBy        BigInt?   @map("updated_by")

  @@index([status, createdAt(sort: Desc)], map: "idx_jobs_status_created")
  @@index([createdAt(sort: Desc)], map: "idx_jobs_created_at")
  @@map("base_jobs")
}

// ---------------------------------------------------------------------------
// DB Enricher — per-data-source schema/data understanding, built by an async
// job (job_type 'db_enrichment' on BaseJob) and consumed by SQL Console AI (and
// future NL surfaces) in place of pure live introspection. dataSourceId is a
// StoredDataSource id string with no FK — connections live in settings.json,
// not this DB — same no-FK pattern as BaseScopeMembership.nodeId above.
// ---------------------------------------------------------------------------

model DbEnrichmentRun {
  id                BigInt    @id @default(autoincrement())
  dataSourceId      String    @map("data_source_id")
  scope             String    @default("FULL")
  scopeTablesJson   String?   @map("scope_tables_json") @db.Text
  status            String    @default("pending")
  jobId             BigInt?   @map("job_id")
  modelId           String?   @map("model_id")
  tablesTotal       Int       @default(0) @map("tables_total")
  tablesProcessed   Int       @default(0) @map("tables_processed")
  columnsResolved   Int       @default(0) @map("columns_resolved")
  columnsAmbiguous  Int       @default(0) @map("columns_ambiguous")
  questionsCreated  Int       @default(0) @map("questions_created")
  overallConfidence Float?    @map("overall_confidence")
  progressLogJson   String?   @map("progress_log_json") @db.Text
  errorMessage      String?   @map("error_message") @db.Text
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  createdAt         DateTime? @default(now()) @map("created_at")
  createdBy         BigInt?   @map("created_by")
  updatedAt         DateTime? @default(now()) @map("updated_at")

  questions DbEnrichmentQuestion[]

  @@index([dataSourceId, createdAt(sort: Desc)], map: "idx_db_enrichment_runs_source_created")
  @@index([status], map: "idx_db_enrichment_runs_status")
  @@map("base_db_enrichment_runs")
}

model DbEnrichmentQuestion {
  id             BigInt    @id @default(autoincrement())
  dataSourceId   String    @map("data_source_id")
  runId          BigInt?   @map("run_id")
  objectType     String    @map("object_type")
  objectName     String    @map("object_name")
  columnName     String?   @map("column_name")
  kind           String
  question       String    @db.Text
  reasonJson     String    @map("reason_json") @db.Text
  candidatesJson String?   @map("candidates_json") @db.Text
  status         String    @default("open")
  answer         String?   @db.Text
  answeredBy     BigInt?   @map("answered_by")
  answeredAt     DateTime? @map("answered_at")
  createdAt      DateTime? @default(now()) @map("created_at")
  updatedAt      DateTime? @default(now()) @map("updated_at")

  run DbEnrichmentRun? @relation(fields: [runId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([dataSourceId, status, createdAt(sort: Desc)], map: "idx_db_enrichment_questions_source_status")
  @@index([runId], map: "idx_db_enrichment_questions_run")
  @@map("base_db_enrichment_questions")
}

model DbEnrichmentKnowledge {
  id                BigInt    @id @default(autoincrement())
  dataSourceId      String    @map("data_source_id")
  objectType        String    @map("object_type")
  objectName        String    @map("object_name")
  tablePurpose      String?   @map("table_purpose") @db.Text
  tableConfidence   Float?    @map("table_confidence")
  columnsJson       String    @default("[]") @map("columns_json") @db.Text
  relationsJson     String    @default("[]") @map("relations_json") @db.Text
  sourceOfTruth     String    @default("INFERRED") @map("source_of_truth")
  lastEnrichedRunId BigInt?   @map("last_enriched_run_id")
  staleSince        DateTime? @map("stale_since")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")

  @@unique([dataSourceId, objectType, objectName], map: "uq_db_enrichment_knowledge_object")
  @@index([dataSourceId], map: "idx_db_enrichment_knowledge_source")
  @@map("base_db_enrichment_knowledge")
}

