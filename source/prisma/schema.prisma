// ---------------------------------------------------------------------------
// Workflow Engine — Slice 1 (domain types, state machines, error registry,
// storage invariants). Normative source: docs/standards/workflow-engine-testing.md
// 03-DOMAIN-MODEL-AND-STORAGE.md. No native Prisma enum/Json — status/type
// columns are plain String (TS union + Zod is sole enum authority); JSON
// columns are String @db.Text, matching every existing model in this file.
// ---------------------------------------------------------------------------

model WorkflowDefinition {
  id                         BigInt    @id @default(autoincrement())
  scopeKey                   String    @default("global") @map("scope_key")
  key                        String
  lifecycleStatus            String    @default("DRAFT") @map("lifecycle_status")
  draftDefinitionJson        String    @db.Text @map("draft_definition_json")
  draftVersion               Int       @default(1) @map("draft_version")
  currentPublishedRevisionId BigInt?   @map("current_published_revision_id")
  nextRevisionNumber         Int       @default(1) @map("next_revision_number")
  createdFromDefinitionId    BigInt?   @map("created_from_definition_id")
  createdFromRevisionId      BigInt?   @map("created_from_revision_id")
  creationMode               String    @default("NEW") @map("creation_mode")
  stateVersion               Int       @default(0) @map("state_version")
  createdAt                  DateTime? @default(now()) @map("created_at")
  createdBy                  BigInt?   @map("created_by")
  updatedAt                  DateTime? @default(now()) @map("updated_at")
  updatedBy                  BigInt?   @map("updated_by")
  lastPublishedAt            DateTime? @map("last_published_at")
  lastPublishedBy            BigInt?   @map("last_published_by")
  lastUnpublishedAt          DateTime? @map("last_unpublished_at")
  lastUnpublishedBy          BigInt?   @map("last_unpublished_by")

  currentPublishedRevision WorkflowRevision?         @relation("DefinitionCurrentRevision", fields: [currentPublishedRevisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions                WorkflowRevision[]        @relation("DefinitionRevisions")
  simulationRuns           WorkflowSimulationRun[]
  validationReports        WorkflowValidationReport[]
  designerViews            WorkflowDesignerView[]
  webhookBinding           WorkflowWebhookBinding?

  @@unique([scopeKey, key], map: "uq_base_workflow_definitions_scope_key")
  @@index([lifecycleStatus], map: "idx_base_workflow_definitions_lifecycle")
  @@index([currentPublishedRevisionId], map: "idx_base_workflow_definitions_current_revision")
  @@map("base_workflow_definitions")
}

// p-68 WHOOK: one active webhook secret per workflow definition. `secretHash` (sha256 of the raw
// secret, never stored in plaintext) is the lookup key for POST /api/workflow-hooks/:token — see
// workflowHooks.controller.ts. Regenerating rotates this row in place (old hash stops matching).
model WorkflowWebhookBinding {
  id                   BigInt    @id @default(autoincrement())
  workflowDefinitionId BigInt    @unique @map("workflow_definition_id")
  workflowRevisionId   BigInt    @map("workflow_revision_id")
  secretHash           String    @unique @map("secret_hash")
  enabled              Boolean   @default(true)
  rotatedAt            DateTime? @map("rotated_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            BigInt?   @map("created_by")

  definition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("base_workflow_webhook_bindings")
}

model WorkflowRevision {
  id                    BigInt    @id @default(autoincrement())
  workflowDefinitionId  BigInt    @map("workflow_definition_id")
  revisionNumber        Int       @map("revision_number")
  sourceDraftVersion    Int       @map("source_draft_version")
  definitionJson        String    @db.Text @map("definition_json")
  actionBindingsJson    String    @db.Text @map("action_bindings_json")
  schemaProjectionsJson String?   @db.Text @map("schema_projections_json")
  semanticFingerprint   String    @map("semantic_fingerprint")
  publicationStatus     String    @map("publication_status")
  bindingStatus         String    @map("binding_status")
  validationReportId    BigInt?   @map("validation_report_id")
  stateVersion          Int       @default(0) @map("state_version")
  publishedAt           DateTime? @map("published_at")
  createdAt             DateTime? @default(now()) @map("created_at")
  createdBy             BigInt?   @map("created_by")
  updatedAt             DateTime? @default(now()) @map("updated_at")
  updatedBy             BigInt?   @map("updated_by")

  definition           WorkflowDefinition         @relation("DefinitionRevisions", fields: [workflowDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentForDefinitions WorkflowDefinition[]      @relation("DefinitionCurrentRevision")
  instances            WorkflowInstance[]
  validationReports     WorkflowValidationReport[] @relation("RevisionValidationReports")
  designerViews         WorkflowDesignerView[]     @relation("RevisionDesignerViews")

  @@unique([workflowDefinitionId, revisionNumber], map: "uq_base_workflow_revisions_definition_number")
  @@index([workflowDefinitionId, publicationStatus], map: "idx_base_workflow_revisions_definition_pub_status")
  @@map("base_workflow_revisions")
}

model WorkflowInstance {
  id                      BigInt    @id @default(autoincrement())
  workflowRevisionId      BigInt    @map("workflow_revision_id")
  status                  String    @default("CREATED")
  inputJson               String?   @db.Text @map("input_json")
  contextJson             String?   @db.Text @map("context_json")
  outputJson              String?   @db.Text @map("output_json")
  startedByType           String    @map("started_by_type")
  startedById             BigInt?   @map("started_by_id")
  startType               String?   @map("start_type")
  nextTraceSequenceNumber Int       @default(1) @map("next_trace_sequence_number")
  stateVersion            Int       @default(0) @map("state_version")
  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @default(now()) @map("updated_at")

  revision           WorkflowRevision      @relation(fields: [workflowRevisionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodeInstances      WorkflowNodeInstance[]
  executionAttempts  WorkflowExecutionAttempt[]
  waits              WorkflowWait[]        @relation("InstanceWaits")
  childSubflowWaits  WorkflowWait[]        @relation("SubflowChildInstance")
  workItems          WorkItem[]
  deadLetters        WorkflowDeadLetter[]
  traces             WorkflowTrace[]
  branchTokens       WorkflowBranchToken[]
  joinArrivals       WorkflowJoinArrival[]

  @@index([workflowRevisionId], map: "idx_base_workflow_instances_revision")
  @@index([status], map: "idx_base_workflow_instances_status")
  @@map("base_workflow_instances")
}

model WorkflowNodeInstance {
  id                      BigInt    @id @default(autoincrement())
  workflowInstanceId      BigInt    @map("workflow_instance_id")
  semanticNodeKey         String    @map("semantic_node_key")
  status                  String    @default("PENDING")
  selectedIncomingEdgeKey String?   @map("selected_incoming_edge_key")
  branchTokenId           BigInt?   @map("branch_token_id")
  joinGroupKey            String?   @map("join_group_key")
  inputJson               String?   @db.Text @map("input_json")
  outputJson              String?   @db.Text @map("output_json")
  nextEligibleAt          DateTime? @map("next_eligible_at")
  leaseOwnerId            String?   @map("lease_owner_id")
  leaseExpiresAt          DateTime? @map("lease_expires_at")
  nextAttemptNumber       Int       @default(1) @map("next_attempt_number")
  stateVersion            Int       @default(0) @map("state_version")
  createdAt               DateTime? @default(now()) @map("created_at")
  updatedAt               DateTime? @default(now()) @map("updated_at")

  instance          WorkflowInstance            @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchToken       WorkflowBranchToken?        @relation(fields: [branchTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  executionAttempts WorkflowExecutionAttempt[]
  wait              WorkflowWait?
  workItem          WorkItem?
  deadLetters       WorkflowDeadLetter[]
  joinArrivals      WorkflowJoinArrival[]
  traces            WorkflowTrace[]

  @@unique([workflowInstanceId, semanticNodeKey], map: "uq_base_workflow_node_instances_occurrence")
  @@index([status, nextEligibleAt], map: "idx_base_workflow_node_instances_claim_scan")
  @@index([workflowInstanceId, status], map: "idx_base_workflow_node_instances_instance_status")
  @@map("base_workflow_node_instances")
}

model WorkflowExecutionAttempt {
  id                        BigInt    @id @default(autoincrement())
  workflowInstanceId        BigInt    @map("workflow_instance_id")
  nodeInstanceId            BigInt    @map("node_instance_id")
  attemptNumber             Int       @map("attempt_number")
  actionKey                 String?   @map("action_key")
  actionVersion             String?   @map("action_version")
  logicalInvocationId       String    @map("logical_invocation_id")
  idempotencyKey            String    @map("idempotency_key")
  status                    String    @default("STARTED")
  selectedProviderId        String?   @map("selected_provider_id")
  selectedProviderVersion   String?   @map("selected_provider_version")
  selectedProviderFingerprint String? @map("selected_provider_fingerprint")
  deadlineAt                DateTime? @map("deadline_at")
  logicalInvocationWindowMs Int?      @map("logical_invocation_window_ms")
  startedAt                 DateTime? @map("started_at")
  completedAt               DateTime? @map("completed_at")
  errorClass                String?   @map("error_class")
  errorCode                 String?   @map("error_code")
  errorMessage              String?   @db.Text @map("error_message")
  resultMetadataJson        String?   @db.Text @map("result_metadata_json")
  stateVersion              Int       @default(0) @map("state_version")
  createdAt                 DateTime? @default(now()) @map("created_at")
  updatedAt                 DateTime? @default(now()) @map("updated_at")

  instance     WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodeInstance WorkflowNodeInstance @relation(fields: [nodeInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([nodeInstanceId, attemptNumber], map: "uq_base_workflow_execution_attempts_node_seq")
  @@index([nodeInstanceId, logicalInvocationId], map: "idx_base_workflow_execution_attempts_logical_invocation")
  @@index([workflowInstanceId], map: "idx_base_workflow_execution_attempts_instance")
  @@map("base_workflow_execution_attempts")
}

model WorkflowWait {
  id                        BigInt    @id @default(autoincrement())
  workflowInstanceId        BigInt    @map("workflow_instance_id")
  owningNodeInstanceId      BigInt    @unique @map("owning_node_instance_id")
  waitType                  String    @map("wait_type")
  status                    String    @default("ACTIVE")
  dueAt                     DateTime? @map("due_at")
  timeoutAt                 DateTime? @map("timeout_at")
  eventName                 String?   @map("event_name")
  correlationKey            String?   @map("correlation_key")
  correlationValueHash      String?   @map("correlation_value_hash")
  correlationEncoderVersion String?   @map("correlation_encoder_version")
  correlationHashAlgorithm  String?   @map("correlation_hash_algorithm")
  childInstanceId           BigInt?   @map("child_instance_id")
  workItemId                BigInt?   @unique @map("work_item_id")
  satisfiedAt               DateTime? @map("satisfied_at")
  resultPayloadJson         String?   @db.Text @map("result_payload_json")
  stateVersion              Int       @default(0) @map("state_version")
  createdAt                 DateTime? @default(now()) @map("created_at")
  updatedAt                 DateTime? @default(now()) @map("updated_at")

  instance           WorkflowInstance     @relation("InstanceWaits", fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  owningNodeInstance WorkflowNodeInstance @relation(fields: [owningNodeInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childInstance      WorkflowInstance?    @relation("SubflowChildInstance", fields: [childInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workItem           WorkItem?            @relation(fields: [workItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, dueAt], map: "idx_base_workflow_waits_status_due")
  @@index([eventName, correlationValueHash, status], map: "idx_base_workflow_waits_event_correlation")
  @@index([workflowInstanceId], map: "idx_base_workflow_waits_instance")
  @@map("base_workflow_waits")
}

model WorkflowEventInbox {
  id                        BigInt    @id @default(autoincrement())
  eventName                 String    @map("event_name")
  providerEventId           String?   @map("provider_event_id")
  eventSourceIdentity       String    @map("event_source_identity")
  correlationEncoderVersion String?   @map("correlation_encoder_version")
  correlationHashAlgorithm  String?   @map("correlation_hash_algorithm")
  correlationValueHash      String?   @map("correlation_value_hash")
  payloadJson               String?   @db.Text @map("payload_json")
  source                    String?
  receivedAt                DateTime  @default(now()) @map("received_at")
  processedAt               DateTime? @map("processed_at")
  status                    String    @default("RECEIVED")
  deduplicationKey          String    @map("deduplication_key")
  recheckUntil              DateTime? @map("recheck_until")
  leaseOwnerId              String?   @map("lease_owner_id")
  leaseExpiresAt            DateTime? @map("lease_expires_at")
  stateVersion              Int       @default(0) @map("state_version")
  createdAt                 DateTime? @default(now()) @map("created_at")
  updatedAt                 DateTime? @default(now()) @map("updated_at")

  @@unique([eventSourceIdentity, deduplicationKey], map: "uq_base_workflow_event_inbox_dedup")
  @@index([status, recheckUntil], map: "idx_base_workflow_event_inbox_recheck_scan")
  @@index([eventName, correlationValueHash, status], map: "idx_base_workflow_event_inbox_correlation_lookup")
  @@map("base_workflow_event_inbox")
}

model WorkItem {
  id                     BigInt    @id @default(autoincrement())
  workflowInstanceId     BigInt    @map("workflow_instance_id")
  nodeInstanceId         BigInt    @unique @map("node_instance_id")
  workItemType           String    @map("work_item_type")
  status                 String    @default("OPEN")
  assignmentStrategy     String?   @map("assignment_strategy")
  assignmentEvidenceJson String?   @db.Text @map("assignment_evidence_json")
  claimedByUserId        BigInt?   @map("claimed_by_user_id")
  priority               Int       @default(0)
  allowedOutcomesJson    String    @db.Text @default("[]") @map("allowed_outcomes_json")
  inputJson              String    @db.Text @map("input_json")
  outputSchemaJson       String?   @db.Text @map("output_schema_json")
  outputJson             String?   @db.Text @map("output_json")
  outcome                String?
  titleText              String    @map("title_text")
  summaryText            String?   @db.Text @map("summary_text")
  claimedAt              DateTime? @map("claimed_at")
  completedAt            DateTime? @map("completed_at")
  stateVersion           Int       @default(0) @map("state_version")
  createdAt              DateTime? @default(now()) @map("created_at")
  updatedAt              DateTime? @default(now()) @map("updated_at")
  /// HWF-2.1 — pure metadata (sort/filter only, no automatic behavior), evaluated once at creation
  /// from the node's `dueAt`/`followUpAt` `CanonicalExpression` (same timing as `titleText`).
  dueAt      DateTime? @map("due_at")
  followUpAt DateTime? @map("follow_up_at")
  /// HWF-3.1 — set only on WorkItems created by the Multi-Approver Policy macro-expansion (a shared
  /// value across every ballot WorkItem of the same logical approval decision); UI grouping only,
  /// no effect on engine dispatch. Null for every ordinary WORK_ITEM node.
  approvalGroupKey String? @map("approval_group_key")

  instance     WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodeInstance WorkflowNodeInstance @relation(fields: [nodeInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wait         WorkflowWait?
  transitions  WorkItemTransition[]
  escalations  WorkItemEscalation[]
  attachments  WorkItemAttachment[]
  comments     WorkItemComment[]

  @@index([status, priority(sort: Desc), createdAt, id], map: "idx_base_work_items_inbox_default_order")
  @@index([status, createdAt], map: "idx_base_work_items_status_created_escalation_scan")
  @@index([claimedByUserId, status], map: "idx_base_work_items_claimed_by_status")
  @@index([workflowInstanceId], map: "idx_base_work_items_instance")
  @@index([approvalGroupKey], map: "idx_base_work_items_approval_group")
  @@map("base_work_items")
}

/// HWF-1.7 — file attachment bytes stored in-DB (deliberately NOT the disk-based `file-manager`/
/// `file-hub` pattern — different philosophy, per user decision 2026-08-30): any authenticated
/// candidate/claimant of a Work Item can attach a file; size/count caps enforced in the service
/// layer, not the schema, so the limits can be tuned without a migration.
model WorkItemAttachment {
  id               BigInt   @id @default(autoincrement())
  workItemId       BigInt   @map("work_item_id")
  filename         String
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  data             Bytes
  uploadedByUserId BigInt   @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workItemId], map: "idx_base_work_item_attachments_work_item")
  @@map("base_work_item_attachments")
}

/// HWF-4.1 — comment thread on a Work Item. Access (both read and write) = current
/// `isActorEligibleForWorkItem` eligibility OR "has already posted at least one comment here"
/// (per user decision 2026-08-30 — avoids the access circle shrinking the moment someone claims).
model WorkItemComment {
  id                   BigInt   @id @default(autoincrement())
  workItemId           BigInt   @map("work_item_id")
  authorUserId         BigInt   @map("author_user_id")
  text                 String   @db.Text
  mentionedUserIdsJson String?  @db.Text @map("mentioned_user_ids_json")
  createdAt            DateTime @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workItemId, createdAt], map: "idx_base_work_item_comments_work_item_created")
  @@map("base_work_item_comments")
}

/// HWF-2.4 — Out-of-Office self-service delegation. Applies ONLY to assignment resolution for
/// NEW Work Items created while `now()` falls in `[startAt, endAt]` (per user decision — no sweep
/// of already-open items; those go through the existing manual ADMIN-reassign / self-service
/// Forward paths). Only meaningful for strategies that resolve to a specific user (USER/
/// EXPRESSION/SAME_AS_WORK_ITEM/ROUND_ROBIN/SHORTEST_QUEUE) — a plain ROLE pool assignment already
/// tolerates absence via its other members.
model WorkItemDelegationRule {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  delegateUserId BigInt   @map("delegate_user_id")
  startAt        DateTime @map("start_at")
  endAt          DateTime @map("end_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, startAt, endAt], map: "idx_base_work_item_delegation_rules_user_window")
  @@map("base_work_item_delegation_rules")
}

/// HWF-4.3 — server-side saved Inbox filter (per user decision 2026-08-30: explicitly NOT
/// localStorage-only, to actually beat the Camunda Tasklist limitation the benchmark flagged).
model WorkItemSavedFilter {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  name       String
  filterJson String   @db.Text @map("filter_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_base_work_item_saved_filters_user")
  @@map("base_work_item_saved_filters")
}

/// HWF-2.2 — single global Business Hours Calendar (per user decision 2026-08-30: one calendar,
/// not per-role/per-type; a dedicated table, not the shared/fragile platform-settings blob system,
/// same precedent as `WorkflowSecretReference`). A singleton row (id always 1); escalation/due-date
/// timers only respect it when explicitly opted in (default off — no existing workflow's behavior
/// changes silently).
model WorkflowBusinessHoursCalendar {
  id              Int      @id @default(1)
  timezone        String   @default("UTC")
  workingDaysJson String   @db.Text @default("[1,2,3,4,5]") @map("working_days_json")
  startTime       String   @default("09:00") @map("start_time")
  endTime         String   @default("17:00") @map("end_time")
  holidaysJson    String   @db.Text @default("[]") @map("holidays_json")
