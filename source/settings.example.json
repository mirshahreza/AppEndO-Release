      },
      {
        "id": "github-dev",
        "kind": "github-oauth",
        "label": "GitHub",
        "enabled": false,
        "autoProvision": true,
        "clientId": "",
        "hasClientSecret": false,
        "redirectUri": "http://localhost:3000/api/auth/oauth/github-dev/callback"
      },
      {
        "id": "microsoft-dev",
        "kind": "microsoft-oauth",
        "label": "Microsoft",
        "enabled": false,
        "autoProvision": true,
        "defaultRoleId": "role_user",
        "clientId": "",
        "hasClientSecret": false,
        "redirectUri": "http://localhost:3000/api/auth/oauth/microsoft-dev/callback",
