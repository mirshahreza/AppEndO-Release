  "deployment": {
    "applyPolicy": "propose",
    "mount": {
      "id": "hawiety",
      "pathPrefix": "/hawiety",
      "name": "Hawiety",
      "defaultRoute": "members-all",
      "authProfile": {
        "requireAuth": true
      },
      "experienceConfig": {
        "locale": "iq",
        "calendar": "gregorian",
        "direction": "rtl",
        "timezone": "Asia/Baghdad"
      }
    },
    "shellRule": {
      "pathPrefix": "/hawiety",
      "shellKey": "hawiety-shell",
      "priority": 10
    },
    "routes": [
      {
        "routePattern": "business-rules/*",
