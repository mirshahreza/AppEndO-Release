    "noEmit": true
  },
  "include": [
    "src/server/domain/workflow/**/*.ts",
    "src/server/controllers/workflows.controller.ts",
    "src/server/controllers/workflowRuntime.controller.ts",
    "src/server/controllers/workflowWorkItems.controller.ts",
    "src/server/controllers/workflowProof.controller.ts",
