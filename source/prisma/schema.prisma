  updatedAt DateTime? @default(now()) @map("updated_at")
  updatedBy BigInt?   @map("updated_by")

  topic BaseInfo  @relation(fields: [topicCode], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user  BaseUser? @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_contact_messages_created_at")
  @@index([topicCode], map: "idx_contact_messages_topic")
  @@index([createdBy], map: "idx_contact_messages_created_by")
  @@map("base_contact_messages")
