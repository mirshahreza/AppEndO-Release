{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/server/index.ts",
    "electron-main.js",
    "index.html",
    "vite.config.ts",
    "scripts/**/*.{ts,mjs}",
    "src/features/file-hub/FileHubPage.tsx",
    "src/features/ssh-hub/SshHubPage.tsx",
    "src/features/rdp-hub/RdpHubPage.tsx",
    "src/features/cms-site/CmsSiteHomePage.tsx",
    "src/features/cms-site/CmsSiteArticlePage.tsx",
    "src/features/cms-site/components/CmsSiteBrandSlot.tsx",
    "src/features/cms-site/components/CmsSiteCtaSlot.tsx",
    "src/features/cms-site/components/CmsSiteFooterSlot.tsx",
    "src/features/cms-site/components/CmsSiteNavSlot.tsx",
    "src/features/hwy-etl-console/HwyEtlConsolePage.tsx",
    "src/features/hwy-business-rules-reference/HwyBusinessRulesReferencePage.tsx",
    "src/features/hwy-org-membership-transfer/HwyOrgMembershipTransferPage.tsx",
    "src/features/hwy-geo-responsibility/HwyGeoResponsibilityPage.tsx",
    "src/features/hwy-courses-activities/HwyCoursesActivitiesPage.tsx",
    "src/features/hwy-targhin-admin/HwyMemberTarghinAdminPage.tsx",
    "src/features/hwy-phone-requests-admin/HwyMemberPhoneRequestsAdminPage.tsx",
    "src/features/hwy-members-targhin/HwyMemberTarghinMembersListPage.tsx",
    "src/features/hwy-member-dossier/HwyMemberDossierPage.tsx",
    "src/features/hwy-member-dossier/HwyMemberDossierViewPage.tsx",
    "src/features/hwy-member-dossier/HwyMemberDossierEditPage.tsx",
    "src/domain/hwy/hwyActivitySelfAnnouncement.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "vite.config.ts"
  ],
  "ignore": [
    "src/generated/**",
    "runtime/**",
    "scripts/archive/**",
    "src/domain/component-designer/DesignerBaseInfoRecordFormField.tsx",
    "src/domain/component-designer/DesignerCmsContentAssetsField.tsx",
    "src/domain/component-designer/DesignerRelatedContentsListField.tsx",
    "src/domain/component-designer/DesignerRelationTagsListField.tsx",
    "src/shared/lib/appendoo/v5Baseline/**",
    "scripts/vite/remote-hub-client-lib-stubs/**"
  ],
  "ignoreDependencies": [
    "@fontsource/ibm-plex-mono",
    "@fontsource/ibm-plex-sans",
    "@fontsource/ibm-plex-sans-arabic",
    "@fontsource/inter",
    "@fontsource/noto-sans-arabic",
    "@fontsource/parastoo",
    "@fontsource/rubik",
    "@fontsource/source-sans-3",
    "@fontsource/vazirmatn",
    "mongodb",
    "mysql2",
    "oracledb",
    "swagger-ui-dist",
    "react-doodle-icons",
    "@tabler/icons-react",
    "@phosphor-icons/react",
    "@heroicons/react",
    "@solar-icons/react",
    "@iconify-json/marketeq",
    "@iconify/react",
    "@iconify-json/simple-icons",
    "animate.css",
    "@huggingface/transformers",
    "sqlite3",
    "tedious",
    "vite",
    "@xterm/xterm",
    "@xterm/addon-fit",
    "basic-ftp",
    "guacamole-common-js"
  ],
  "rules": {
    "files": "error",
    "exports": "warn",
    "types": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "duplicates": "warn"
  }
}
