exports[`designer runtime parity snapshots > renders HeroUI preview markup for heroui.tags-input 1`] = `
<div
  class="min-h-0 space-y-3 overflow-y-auto"
>
  <div
    class="min-w-0 flex flex-wrap items-center gap-2 rounded-md border border-slate-300 bg-white p-2 text-xs text-slate-700"
    data-designer-component="heroui.tags-input"
  >
    <div
      class="flex w-full flex-col gap-[2px]"
    >
      <div
        class="flex flex-wrap items-center gap-1 rounded-md border border-slate-300 bg-white px-2 py-1"
      >
        <template />
        <div
          class="tag-group"
          data-slot="tag-group"
        >
          <div
            aria-atomic="false"
            aria-label="Tags"
            aria-live="off"
            aria-relevant="additions"
            class="tag-group__list"
            data-collection="react-aria-_r_m_"
            data-rac=""
            data-slot="tag-group-list"
            id="react-aria-_r_h_"
            role="grid"
            tabindex="0"
          >
            <div
              aria-label="alpha"
              class="tag tag--md tag--default"
              data-collection="react-aria-_r_m_"
              data-key="react-aria-1"
              data-rac=""
              data-slot="tag"
              id="react-aria-_r_h_-react-aria-1"
              role="row"
              tabindex="0"
            >
              <div
                aria-colindex="1"
                role="gridcell"
                style="display: contents;"
              >
                alpha
              </div>
            </div>
            <div
              aria-label="beta"
              class="tag tag--md tag--default"
              data-collection="react-aria-_r_m_"
              data-key="react-aria-2"
              data-rac=""
              data-slot="tag"
              id="react-aria-_r_h_-react-aria-2"
              role="row"
              tabindex="0"
            >
              <div
                aria-colindex="1"
                role="gridcell"
                style="display: contents;"
              >
                beta
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

