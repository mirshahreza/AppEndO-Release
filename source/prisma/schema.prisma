/**
 * A friendly-named pointer to a server environment variable an Action's `secretReferenceFields`
 * may hold — NEVER the secret value itself (no credential vault exists in this platform; see
 * `secretResolution.ts`'s `resolveWorkflowSecretFromEnv`, unchanged by this model). This table lets
 * an admin register "SLACK_WEBHOOK_URL" once with a human label/description so the Designer can
 * offer it as a one-click pick instead of an author having to already know/type the exact env var
 * name. Deliberately NOT a credential store — adding a real vault (encrypted values, access
 * control) is a separate, larger platform decision.
 */
model WorkflowSecretReference {
  id                 BigInt    @id @default(autoincrement())
  name               String    @map("name")
  label              String    @map("label")
  description        String?   @db.Text @map("description")
  /// p-99/WFT-3 — AES-256-GCM JSON blob (`WorkflowCredentialEncryptedBlob`), never a plaintext
  /// value; null means this reference is still name-only (Option 1 env-var indirection, unchanged
  /// backward-compatible behavior). See `workflowCredentialCrypto.ts`.
  encryptedValueJson String?   @db.Text @map("encrypted_value_json")
  createdAt          DateTime? @default(now()) @map("created_at")
  createdBy          BigInt?   @map("created_by")
  updatedAt          DateTime? @default(now()) @map("updated_at")
  updatedBy          BigInt?   @map("updated_by")

  @@unique([name], map: "uq_base_workflow_secret_references_name")
  @@map("base_workflow_secret_references")
}

