# Copy to `.env` and set your local PostgreSQL password.
# Used when settings.json dataSources[].password is the placeholder "PGPASSWORD".
PGPASSWORD=your_postgres_password

# Required in production — 32-byte AES-256-GCM master key for the Core Credential Vault
# (64 hex characters or base64). Compromising this key decrypts every vault secret
# (data-source passwords, hub secrets, API tokens, SMTP/Redis, AI keys, …).
# APPENDO_CREDENTIAL_MASTER_KEY=
# Optional integer; default 1. Bump together with a new MASTER_KEY during rotation.
# APPENDO_CREDENTIAL_KEY_VERSION=1
# Previous-generation key; keep only until rotate-credential-secrets finishes, then unset.
# APPENDO_CREDENTIAL_MASTER_KEY_PREVIOUS=

# Optional — used for absolute links in verification/reset emails.
APP_URL=http://localhost:3000

# Optional — Hawiety / platform SMS gateway (legacy MessagingUtils.SendSMS parity).
# SMS_GATEWAY_URL=http://your-sms-gateway?token=...
# SMS_ENABLED=1
# SMS_FORCE_GATEWAY=1

# Optional — Firebase Cloud Messaging (legacy MessagingUtils.SendNotification parity).
# MESSAGING_FIREBASE_CREDENTIALS_PATH=C:/Workspace/Projects/HawietySite/HawietySite/members-echosystem-firebase.json
# PUSH_ENABLED=1
# PUSH_FORCE_FCM=1
# MESSAGING_PUSH_TOPIC_NAMESPACE=hawiety

# Optional — GitHub browser sign-in for Connect to Git wizard.
# GIT_GITHUB_OAUTH_CLIENT_ID=
# GIT_GITHUB_OAUTH_CLIENT_SECRET=

# Optional — guacd used by RDP Hub (defaults 127.0.0.1:4822).
# GUACD_HOST=127.0.0.1
# GUACD_PORT=4822
