        "pageKey": "hwy-courses-activities"
      },
      {
        "routePattern": "employees-list",
        "pageKey": "hwy-employees-list"
      },
      {
        "routePattern": "etl-console",
        "pageKey": "hwy-etl-console"
      },
      {
        "routePattern": "geo-responsibility/*",
        "pageKey": "hwy-geo-responsibility"
      },
      {
        "routePattern": "meetings-management",
        "pageKey": "hwy-meetings-management"
      },
      {
        "routePattern": "members-all/edit/*",
        "pageKey": "hwy-member-dossier-edit"
      },
      {
        "routePattern": "members-all/view/*",
        "pageKey": "hwy-member-dossier-view"
      },
      {
        "routePattern": "members-org-membership-transfer",
        "pageKey": "hwy-org-membership-transfer"
      },
      {
        "routePattern": "members-targhin",
        "pageKey": "hwy-members-targhin"
      },
      {
        "routePattern": "targhin-requests",
        "pageKey": "hwy-targhin-requests"
      }
    ]
  },
