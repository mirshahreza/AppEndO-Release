{
  "database": {
    "provider": "sqlserver",
    "url": "sqlserver://localhost;database=AppEnd;user=sa;encrypt=true;trustServerCertificate=true",
    "engine": "prisma"
  },
  "runtime": {
    "nodeEnv": "development",
    "port": 3000,
    "appUrl": "http://localhost:3000",
    "accessTokenSecret": "dev_access_token_secret_change_me",
    "refreshTokenSecret": "dev_refresh_token_secret_change_me",
    "databaseProvider": "sqlserver",
    "disableHmr": false,
    "hmrPort": 0,
    "logLevel": "debug",
    "pluginScriptPolicyTimeoutMs": 3000,
    "pluginScriptAllowedPathPrefixes": "db/install/,db/uninstall/,db/seed/,sql/",
    "pluginEventRetentionMonths": 6,
    "pluginEventRetentionMaxTotalBytes": 104857600,
    "nodeName": "node-1",
    "capabilities": [
      "service",
      "platform",
      "worker"
    ]
  },
  "install": {
    "pending": true
  },
  "dataSources": [
    {
      "id": "ds_default",
      "name": "default-db",
      "type": "SQL Server",
      "host": "localhost",
      "port": 1433,
      "database": "AppEnd",
      "username": "sa",
      "encrypt": true,
      "trustServerCertificate": true,
      "pooling": false,
      "status": "connected",
      "isDefault": true,
      "created_at": "2026-05-29T00:00:00.000Z",
      "updated_at": "2026-05-29T04:48:09.124Z"
    }
  ],
  "plugins": [],
  "ai": {
    "enabled": true,
    "defaultModelId": "",
    "chatRateLimitPerMinute": 20,
    "models": [],
    "providers": [],
