/** HWF-4.2 — per-user, per-event-type notification channel preference. Absence of a row for
 * (userId, eventType) means the untouched default (IN_APP, immediate) — opt-in only, so no existing
 * user's notification behavior changes until they explicitly set a preference. */
model UserNotificationPreference {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  eventType String    @map("event_type")
  channel   String
  digest    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")

  user BaseUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, eventType], map: "uq_user_notification_preferences_user_event")
  @@map("base_user_notification_preferences")
}

/** HWF-4.2 — EMAIL+digest queue: an item lands here instead of an immediate send when the user's
 * preference for its eventType is `channel: 'EMAIL', digest: true`; the digest scanner
 * (`workflowEngineWorker.ts`) periodically batches a user's pending items into one summary email and
 * stamps `sentAt`. */
model UserNotificationDigestItem {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  title        String
  body         String    @db.Text
  href         String?
  source       String
  metadataJson String?   @db.Text @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  sentAt       DateTime? @map("sent_at")

  user BaseUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, sentAt], map: "idx_user_notification_digest_items_user_pending")
  @@map("base_user_notification_digest_items")
}

